{
  "$description": "Tokens de design do Transly UI Kit (formato W3C Design Tokens). Fonte única de verdade: scripts/build-tokens.mjs gera styles/tokens.css. Nome CSS = caminho unido por hífen (color.bg -> --color-bg). Referências {palette.lime.400} viram var(--palette-lime-400). O tema padrão é escuro (:root); 'themes.light' redefine os tokens semânticos em [data-theme=\"light\"].",
  "meta": {
    "name": { "$value": "Transly UI Kit", "$type": "string" },
    "version": { "$value": "1.3.0", "$type": "string" },
    "reference": { "$value": "references/referencia-original.png", "$type": "string" }
  },

  "palette": {
    "$description": "Cores brutas tiradas da referência (app financeiro escuro sobre fundo laranja). Nos componentes use os tokens semânticos de 'color'.",
    "graphite": {
      "950": { "$value": "#141416", "$type": "color", "$description": "Sombra profunda / fundo do desktop escuro" },
      "900": { "$value": "#1C1C1F", "$type": "color", "$description": "Corpo da janela (referência: tela do celular)" },
      "850": { "$value": "#242427", "$type": "color" },
      "800": { "$value": "#2B2B2F", "$type": "color", "$description": "Cartões (referência: cartão VISA)" },
      "700": { "$value": "#38383D", "$type": "color", "$description": "Pílula escura (referência: botão REQUEST)" },
      "600": { "$value": "#4A4A50", "$type": "color" },
      "500": { "$value": "#6A6A72", "$type": "color" },
      "400": { "$value": "#8E8E96", "$type": "color" },
      "300": { "$value": "#B6B6BC", "$type": "color" },
      "200": { "$value": "#D7D7DB", "$type": "color", "$description": "Pílula clara (referência: botão SEND)" },
      "100": { "$value": "#ECECEF", "$type": "color" },
      "50": { "$value": "#F6F6F8", "$type": "color" },
      "0": { "$value": "#FFFFFF", "$type": "color" }
    },
    "lime": {
      "300": { "$value": "#ECFB9C", "$type": "color" },
      "400": { "$value": "#DDF56B", "$type": "color", "$description": "Destaque principal (referência: selo $5,867 e linha Income)" },
      "600": { "$value": "#A9C232", "$type": "color" },
      "800": { "$value": "#4E5A12", "$type": "color" }
    },
    "sky": { "400": { "$value": "#7DBBF2", "$type": "color" }, "700": { "$value": "#2E6FA8", "$type": "color" } },
    "violet": { "400": { "$value": "#7F87F0", "$type": "color" }, "700": { "$value": "#4048B8", "$type": "color" } },
    "green": { "400": { "$value": "#6CC07A", "$type": "color" }, "700": { "$value": "#2F7D3D", "$type": "color" } },
    "coral": { "400": { "$value": "#F2736B", "$type": "color" }, "700": { "$value": "#B83A33", "$type": "color" } },
    "amber": { "400": { "$value": "#F6A84E", "$type": "color" }, "700": { "$value": "#B5661A", "$type": "color" } },
    "tangerine": {
      "300": { "$value": "#F2B877", "$type": "color" },
      "400": { "$value": "#E89A4C", "$type": "color", "$description": "Fundo da referência; usado como papel de parede do desktop" },
      "600": { "$value": "#C9762A", "$type": "color" }
    }
  },

  "color": {
    "$description": "Tokens semânticos (tema escuro = padrão).",
    "bg": { "$value": "{palette.graphite.900}", "$type": "color", "$description": "Fundo da janela flutuante" },
    "bg-sunken": { "$value": "{palette.graphite.950}", "$type": "color" },
    "surface": { "$value": "{palette.graphite.800}", "$type": "color", "$description": "Cartões" },
    "surface-2": { "$value": "{palette.graphite.700}", "$type": "color", "$description": "Pílulas, campos, hover de linha" },
    "surface-3": { "$value": "{palette.graphite.600}", "$type": "color" },
    "surface-inverse": { "$value": "{palette.graphite.200}", "$type": "color", "$description": "Pílula clara (botão secundário)" },
    "on-inverse": { "$value": "{palette.graphite.900}", "$type": "color" },
    "text": { "$value": "{palette.graphite.50}", "$type": "color" },
    "text-2": { "$value": "{palette.graphite.400}", "$type": "color", "$description": "Texto de apoio (referência: 'Debit Card')" },
    "text-3": { "$value": "{palette.graphite.500}", "$type": "color", "$description": "Rótulos fracos (referência: 'Today')" },
    "line": { "$value": "rgba(255,255,255,0.07)", "$type": "color", "$description": "Divisórias entre linhas de lista" },
    "line-strong": { "$value": "rgba(255,255,255,0.14)", "$type": "color" },
    "accent": { "$value": "{palette.lime.400}", "$type": "color", "$description": "Cor do CTA primário e do estado ativo" },
    "accent-strong": { "$value": "{palette.lime.300}", "$type": "color" },
    "on-accent": { "$value": "{palette.graphite.900}", "$type": "color" },
    "accent-soft": { "$value": "rgba(221,245,107,0.14)", "$type": "color" },
    "info": { "$value": "{palette.sky.400}", "$type": "color" },
    "voice": { "$value": "{palette.violet.400}", "$type": "color", "$description": "Tudo que é áudio/transcrição" },
    "success": { "$value": "{palette.green.400}", "$type": "color" },
    "danger": { "$value": "{palette.coral.400}", "$type": "color" },
    "warning": { "$value": "{palette.amber.400}", "$type": "color" },
    "focus": { "$value": "{palette.lime.400}", "$type": "color" },
    "scrim": { "$value": "rgba(10,10,12,0.55)", "$type": "color" },
    "wallpaper": { "$value": "{palette.tangerine.400}", "$type": "color", "$description": "Papel de parede das telas de desktop" },
    "wallpaper-2": { "$value": "{palette.tangerine.600}", "$type": "color" }
  },

  "chart": {
    "$description": "Cores categóricas dos gráficos, na ordem de uso (referência: donut Home/Charity/Food/Other).",
    "1": { "$value": "{palette.sky.400}", "$type": "color" },
    "2": { "$value": "{palette.violet.400}", "$type": "color" },
    "3": { "$value": "{palette.green.400}", "$type": "color" },
    "4": { "$value": "{palette.lime.400}", "$type": "color" },
    "5": { "$value": "{palette.coral.400}", "$type": "color" },
    "6": { "$value": "{palette.amber.400}", "$type": "color" },
    "muted": { "$value": "{palette.graphite.600}", "$type": "color" }
  },

  "font": {
    "family": {
      "sans": { "$value": "'Inter Variable', 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "'JetBrains Mono Variable', ui-monospace, 'Cascadia Code', Consolas, monospace", "$type": "fontFamily", "$description": "Teclas de atalho e tempos de transcrição" }
    },
    "size": {
      "caption": { "$value": "11px", "$type": "dimension", "$description": "Rótulos em caixa alta (referência: SEND / REQUEST)" },
      "small": { "$value": "12.5px", "$type": "dimension" },
      "body": { "$value": "14px", "$type": "dimension" },
      "input": { "$value": "19px", "$type": "dimension", "$description": "Texto digitado na barra de busca" },
      "title": { "$value": "17px", "$type": "dimension" },
      "result": { "$value": "22px", "$type": "dimension", "$description": "Texto traduzido" },
      "display": { "$value": "34px", "$type": "dimension", "$description": "Números de destaque (referência: 24,281.12)" }
    },
    "weight": {
      "regular": { "$value": "400", "$type": "fontWeight" },
      "medium": { "$value": "500", "$type": "fontWeight" },
      "semibold": { "$value": "600", "$type": "fontWeight" },
      "bold": { "$value": "700", "$type": "fontWeight" }
    },
    "leading": {
      "tight": { "$value": "1.15", "$type": "number" },
      "normal": { "$value": "1.45", "$type": "number" }
    },
    "tracking": {
      "caps": { "$value": "0.08em", "$type": "dimension" },
      "display": { "$value": "-0.02em", "$type": "dimension" }
    }
  },

  "space": {
    "0": { "$value": "0px", "$type": "dimension" },
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "5": { "$value": "20px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "8": { "$value": "32px", "$type": "dimension" },
    "10": { "$value": "40px", "$type": "dimension" }
  },

  "radius": {
    "sm": { "$value": "10px", "$type": "dimension" },
    "md": { "$value": "14px", "$type": "dimension", "$description": "Campos, itens de menu" },
    "lg": { "$value": "20px", "$type": "dimension", "$description": "Cartões" },
    "xl": { "$value": "26px", "$type": "dimension", "$description": "Janela flutuante" },
    "pill": { "$value": "999px", "$type": "dimension" }
  },

  "size": {
    "window-width": { "$value": "640px", "$type": "dimension", "$description": "Largura da janela flutuante (desktop)" },
    "window-max-height": { "$value": "640px", "$type": "dimension", "$description": "Altura máxima; o conteúdo rola por dentro" },
    "window-compact": { "$value": "420px", "$type": "dimension", "$description": "Largura das janelas de Ajustes/Boas-vindas" },
    "control": { "$value": "40px", "$type": "dimension" },
    "control-sm": { "$value": "32px", "$type": "dimension" },
    "icon": { "$value": "20px", "$type": "dimension" }
  },

  "shadow": {
    "card": { "$value": "0 1px 0 rgba(255,255,255,0.04) inset, 0 8px 24px rgba(0,0,0,0.28)", "$type": "shadow" },
    "window": { "$value": "0 1px 0 rgba(255,255,255,0.06) inset, 0 30px 80px rgba(0,0,0,0.45), 0 10px 24px rgba(0,0,0,0.3)", "$type": "shadow", "$description": "Janela flutuante sobre o desktop" },
    "pop": { "$value": "0 18px 40px rgba(0,0,0,0.45)", "$type": "shadow", "$description": "Menus, popovers, tooltips" },
    "glow": { "$value": "0 0 0 6px rgba(221,245,107,0.12), 0 6px 24px rgba(221,245,107,0.25)", "$type": "shadow", "$description": "Halo do CTA/mic ativo" }
  },

  "motion": {
    "$description": "Movimento suave e com mola. Sempre respeite prefers-reduced-motion (styles/global.css zera as durações; motion/react usa MotionConfig reducedMotion='user').",
    "duration": {
      "instant": { "$value": "120ms", "$type": "duration" },
      "fast": { "$value": "200ms", "$type": "duration", "$description": "Hover, pressão" },
      "base": { "$value": "320ms", "$type": "duration", "$description": "Troca de estado de ícone, toggle" },
      "slow": { "$value": "480ms", "$type": "duration", "$description": "Entrada de cartões, gráficos" },
      "window": { "$value": "560ms", "$type": "duration", "$description": "Abrir/fechar janela flutuante" },
      "loop": { "$value": "1400ms", "$type": "duration", "$description": "Animações em loop (gravando, carregando)" }
    },
    "ease": {
      "out": { "$value": "cubic-bezier(0.16, 1, 0.3, 1)", "$type": "cubicBezier", "$description": "Padrão de entrada (expo out)" },
      "in-out": { "$value": "cubic-bezier(0.65, 0, 0.35, 1)", "$type": "cubicBezier" },
      "in": { "$value": "cubic-bezier(0.55, 0, 1, 0.45)", "$type": "cubicBezier", "$description": "Saída" },
      "spring": { "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)", "$type": "cubicBezier", "$description": "Leve ultrapassagem (ícones, pressão)" }
    },
    "spring": {
      "$description": "Configurações para motion/react (lidas por components/_utils/motion.js).",
      "snappy": { "$value": "420 32", "$type": "string", "$description": "stiffness damping: botões, indicador de abas" },
      "soft": { "$value": "260 28", "$type": "string", "$description": "Janela, cartões" },
      "bouncy": { "$value": "520 18", "$type": "string", "$description": "Ícones de confirmação" }
    }
  },

  "bubble": {
    "$description": "Bolha flutuante: fica por cima de todas as janelas do sistema e mostra a tradução do texto copiado (ver DESIGN.md §11).",
    "size": { "$value": "56px", "$type": "dimension", "$description": "Diâmetro da bolha" },
    "card-width": { "$value": "340px", "$type": "dimension", "$description": "Largura do cartão de tradução ao lado da bolha" },
    "edge-gap": { "$value": "12px", "$type": "dimension", "$description": "Distância da borda da tela quando a bolha gruda nela" },
    "opacity": { "$value": "0.8", "$type": "number", "$description": "Opacidade padrão (80%), ajustável nos Ajustes; volta a 100% no hover, ao arrastar e com o cartão aberto" },
    "opacity-min": { "$value": "0.3", "$type": "number", "$description": "Menor opacidade permitida (30%), para a bolha não sumir" },
    "hide-after": { "$value": "8000ms", "$type": "duration", "$description": "O cartão fecha sozinho depois disso; pausa enquanto o mouse está em cima" },
    "min-chars": { "$value": "2", "$type": "number", "$description": "Textos copiados menores que isso são ignorados" }
  },

  "window": {
    "$description": "Janela principal: transparência escolhida em Ajustes → Geral (ver DESIGN.md §4.1).",
    "opacity": { "$value": "1", "$type": "number", "$description": "Opacidade padrão da janela (100%, opaca)" },
    "opacity-min": { "$value": "0.5", "$type": "number", "$description": "Menor opacidade permitida (50%), para o texto continuar legível" }
  },

  "plan": {
    "$description": "Plano Free e Pro vitalício com teste grátis: limites do Free e regras da licença (ver DESIGN.md §12).",
    "free-bubble-daily": { "$value": "20", "$type": "number", "$description": "Traduções por dia na bolha no Free; depois aparece o cartão de limite com 'Ver o Pro'" },
    "trial-days": { "$value": "7", "$type": "number", "$description": "Dias de teste do Pro, sem cartão" },
    "offline-days": { "$value": "30", "$type": "number", "$description": "A licença Pro vale offline por até 30 dias sem falar com o servidor" },
    "revalidate-days": { "$value": "7", "$type": "number", "$description": "A licença é revalidada em segundo plano a cada 7 dias" }
  },

  "update": {
    "$description": "Atualização automática em segundo plano (ver DESIGN.md §13).",
    "check-every": { "$value": "24h", "$type": "duration", "$description": "Verifica uma vez por dia, além do botão 'Verificar atualização'" }
  },

  "z": {
    "window": { "$value": "10", "$type": "number" },
    "popover": { "$value": "40", "$type": "number" },
    "toast": { "$value": "60", "$type": "number" },
    "bubble": { "$value": "90", "$type": "number", "$description": "Acima de tudo, inclusive da janela principal (always on top)" }
  },

  "themes": {
    "light": {
      "$description": "Variante clara: mesmas cores de destaque, superfícies claras.",
      "color": {
        "bg": { "$value": "{palette.graphite.50}", "$type": "color" },
        "bg-sunken": { "$value": "{palette.graphite.100}", "$type": "color" },
        "surface": { "$value": "{palette.graphite.0}", "$type": "color" },
        "surface-2": { "$value": "{palette.graphite.100}", "$type": "color" },
        "surface-3": { "$value": "{palette.graphite.200}", "$type": "color" },
        "surface-inverse": { "$value": "{palette.graphite.900}", "$type": "color" },
        "on-inverse": { "$value": "{palette.graphite.50}", "$type": "color" },
        "text": { "$value": "{palette.graphite.900}", "$type": "color" },
        "text-2": { "$value": "#5E5E66", "$type": "color" },
        "text-3": { "$value": "#7C7C84", "$type": "color" },
        "line": { "$value": "rgba(20,20,22,0.08)", "$type": "color" },
        "line-strong": { "$value": "rgba(20,20,22,0.16)", "$type": "color" },
        "accent-soft": { "$value": "rgba(169,194,50,0.18)", "$type": "color" },
        "focus": { "$value": "{palette.lime.600}", "$type": "color" },
        "info": { "$value": "{palette.sky.700}", "$type": "color" },
        "voice": { "$value": "{palette.violet.700}", "$type": "color" },
        "success": { "$value": "{palette.green.700}", "$type": "color" },
        "danger": { "$value": "{palette.coral.700}", "$type": "color" },
        "warning": { "$value": "{palette.amber.700}", "$type": "color" },
        "scrim": { "$value": "rgba(20,20,22,0.28)", "$type": "color" }
      },
      "shadow": {
        "card": { "$value": "0 1px 2px rgba(20,20,22,0.06), 0 8px 24px rgba(20,20,22,0.06)", "$type": "shadow" },
        "window": { "$value": "0 30px 80px rgba(60,30,0,0.28), 0 10px 24px rgba(60,30,0,0.16)", "$type": "shadow" },
        "pop": { "$value": "0 18px 40px rgba(20,20,22,0.18)", "$type": "shadow" }
      }
    }
  }
}
